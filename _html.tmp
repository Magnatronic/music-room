<canvas id="c"></canvas>
<div id="bands" class="hidden"></div>
<div id="unlockZone"></div>
<div id="lockHint">Controls locked — press and hold the top-left corner for 3 seconds to unlock</div>
<div id="stats"></div>

<div id="ui">
  <div id="rail">
    <a href="index.html" id="homeBtn" class="btn" title="Home">⌂</a>
    <button class="btn" id="collapse" title="Menu">≡</button>
    <div id="railExtra"></div>
  </div>
  <div id="menuExpand">
    <div id="bottomRow">
      <button class="bbar" id="btnInstrument" data-mode="instrument">🎵 Notes</button>
      <button class="bbar" id="btnSound"      data-mode="sound">🎸 Instrument</button>
      <button class="bbar" id="btnVisuals"    data-mode="visuals">✨ Visuals</button>
      <button class="bbar" id="btnPresets"    data-mode="presets">⭐ Presets</button>
    </div>
    <div id="quickRow"></div>
  </div>
  <div id="panel">
    <div class="pane" id="paneInstrument">
      <div id="instrumentContent"></div>
    </div>
    <div class="pane" id="paneSound">
      <div id="soundControls"></div>
    </div>
    <div class="pane" id="paneVisuals">
      <div id="visualsContent"></div>
    </div>
    <div class="pane" id="panePresets">
      <div id="presetsContent"></div>
    </div>
  </div>
</div>
